# ------------------------------------------------------------------
# Bara Pro CI — Variables d'environnement
# ------------------------------------------------------------------
# Copie ce fichier en `.env.local` et renseigne tes clés.
# IMPORTANT : le site tourne en local MÊME sans ces clés
# (les formulaires basculent en mode "démo" et ne plantent pas).
# ------------------------------------------------------------------

# --- Supabase (base de données + auth) ---
# Tableau de bord : https://supabase.com/dashboard -> Project Settings -> API
# NEXT_PUBLIC_* : requis pour l'AUTH (connexion/inscription/Google).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : réservée au serveur (waitlist/newsletter), ne JAMAIS l'exposer côté client
SUPABASE_SERVICE_ROLE_KEY=
#
# Auth — étapes une fois les clés ci-dessus renseignées :
#   1. Exécuter supabase/migrations/0001_init.sql PUIS 0002_auth_profiles.sql
#      (Supabase -> SQL Editor).
#   2. Authentication -> URL Configuration : Site URL = http://localhost:3000
#      (+ ton domaine en prod) ; Redirect URLs : .../auth/callback
#   3. Google : Authentication -> Providers -> Google -> activer, puis coller
#      le Client ID / Secret depuis Google Cloud (OAuth), avec l'URL de
#      callback indiquée par Supabase.

# --- Resend (emails transactionnels : confirmation liste d'attente, contact) ---
# Clés : https://resend.com/api-keys
RESEND_API_KEY=
# Adresse d'envoi vérifiée sur ton domaine Resend
RESEND_FROM_EMAIL="Bara Pro CI <onboarding@resend.dev>"
# Adresse qui reçoit les messages du formulaire de contact
CONTACT_TO_EMAIL=holy.corporation.us@gmail.com

# --- Site ---
# URL publique (utilisée pour le SEO, l'Open Graph, le sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Newsletter programmée (Vercel Cron) ---
# Jeton attendu par /api/cron/newsletter. Défini dans les variables Vercel :
# Vercel l'envoie automatiquement dans l'en-tête Authorization des crons.
# Sans ce jeton, la route reste fermée (aucun envoi possible).
CRON_SECRET=

# --- Admin ---
# Emails autorisés à accéder à /tableau-de-bord/admin (séparés par des virgules).
# Optionnel : à défaut, les adresses du fondateur sont utilisées (lib/admin.ts).
ADMIN_EMAILS=
